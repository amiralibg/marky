# Copy to .env and fill in. Never commit the real file.

# Port the API listens on (Dockerfile EXPOSE and nginx proxy expect 8000).
PORT=8000

# Comma-separated origins allowed to call the API. The website itself:
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string.
MONGODB_URI=mongodb://mongo:27017/marky-feedback

# Secret for signing visitor sessions (generate: openssl rand -base64 48).
JWT_SECRET=replace-me

# Secret for signing admin sessions (use a DIFFERENT value than JWT_SECRET).
ADMIN_JWT_SECRET=replace-me-too

# The single admin account. Seeded by `npm run seed:admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
